{
  "name": "dsh-turn-ding",
  "version": "0.1.4",
  "description": "Windows taskbar unread badge and completion chime for DeepSeek Harness turns",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "index.json",
    "README.md",
    "LICENSE",
    "icon.png"
  ],
  "icon": "./icon.png",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "badge",
    "notification",
    "windows",
    "taskbar"
  ],
  "author": "Arron Gao <arron.gaoxc@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arrongao/dsh-turn-ding.git"
  },
  "homepage": "https://github.com/arrongao/dsh-turn-ding",
  "os": [
    "win32"
  ],
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.1-alpha.2 <0.4.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "manifestVersion": 1
  }
}
